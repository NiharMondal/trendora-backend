{
    "name": "server",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "postinstall": "prisma generate",
        "start": "node dist/server.js",
        "build": "tsc && tsc-alias",
        "lint": "eslint ./src",
        "lint:fix": "eslint ./src --fix",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
        "stripe:listen": "stripe listen --forward-to localhost:5001/webhook --events checkout.session.completed,checkout.session.expired,payment_intent.succeeded,payment_intent.payment_failed,refund.created,refund.updated,refund.failed,charge.refunded",
        "seed": "tsx src/seed/index.ts",
        "studio": "npx prisma studio"
    },
    "prisma": {
        "seed": "tsx src/seed/index.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@10.14.0",
    "dependencies": {
        "@prisma/client": "^6.13.0",
        "@prisma/extension-accelerate": "^2.0.2",
        "axios": "^1.11.0",
        "bcrypt": "^6.0.0",
        "cloudinary": "^2.9.0",
        "cors": "^2.8.5",
        "dotenv": "^17.2.1",
        "express": "^5.1.0",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.12.1",
        "node-cron": "^4.6.0",
        "nodemailer": "^10.0.10",
        "slugify": "^1.6.6",
        "sslcommerz-lts": "^1.2.0",
        "stripe": "^18.4.0",
        "zod": "^4.0.17"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/morgan": "^1.9.10",
        "@types/node": "^24.2.1",
        "@types/node-cron": "^3.0.11",
        "@types/nodemailer": "^8.0.2",
        "eslint": "^9.39.2",
        "prisma": "^6.13.0",
        "ts-node-dev": "^2.0.0",
        "tsc-alias": "^1.9.5",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.20.3",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.52.0"
    }
