# Validated at boot by src/config/env-config.ts — the server refuses to start
# on a bad value rather than failing at the first request that needs it.
#
#   REQUIRED           DATABASE_URL, ACCESS_TOKEN_SECRET, REFRESH_TOKEN_SECRET
#   OPTIONAL           everything else has a default (shown below)
#   FEATURE-GATED      Stripe / Cloudinary / EMAIL — the server boots without
#                      them and logs which features are disabled
#
# Numbers are range-checked: TAX_RATE=abc and TAX_RATE=5 are both boot errors.

NODE_ENV = development

DATABASE_URL="postgresql://<username>:<password>@localhost:5432/trendora?schema=public"
PORT = 5001

ACCESS_TOKEN_EXPIRES= 1d
REFRESH_TOKEN_EXPIRES= 30d
REFRESH_TOKEN_SECRET= 
ACCESS_TOKEN_SECRET= 

# cloudinary
CLOUD_NAME = 
API_SECRET = 
API_KEY = 

#stripe
STRIPE_SECRET_KEY = 
# Signing secret for POST /webhook.
#
# LOCAL DEV: run `pnpm stripe:listen` (needs the Stripe CLI:
# `brew install stripe/stripe-cli/stripe && stripe login`). It prints a
# `whsec_...` — put THAT here. It is specific to the listen session and is not
# the same as a registered endpoint's secret.
#
# DEPLOYED: use the signing secret of the webhook endpoint whose URL points at
# this backend. That endpoint must have all eight events `pnpm stripe:listen`
# forwards enabled, or refunds and orders will silently not reconcile.
STRIPE_WEBHOOK_SECRET = 

FRONTEND_URL = http://localhost:3000

# order
TAX_RATE = 0.05
# SHIPPING_COST / FREE_SHIPPING_THRESHOLD are DEFAULTS for a newly created
# store. Live pricing reads Vendor.shippingFee / Vendor.freeShippingThreshold,
# so editing these only affects stores created afterwards.
SHIPPING_COST = 100
FREE_SHIPPING_THRESHOLD = 1000
DISCOUNT_RATE = 0.1

# marketplace
# Default platform cut of a vendor's merchandise subtotal (0.10 = 10%).
# Snapshotted onto Vendor.commissionRate at application time; an admin can
# change it per store via PATCH /vendors/:id/settings.
PLATFORM_COMMISSION_RATE = 0.10
# How long an unpaid Stripe checkout draft stays redeemable, in minutes.
CHECKOUT_SESSION_TTL_MINUTES = 60

# dev seed password (src/seed) — not read by the running server
SEED_PASSWORD = Password123!


# for sending email
# SMTP credentials. For Gmail, PASSWORD must be an APP PASSWORD
# (Google Account -> Security -> 2-Step Verification -> App passwords),
# not the account password. Without these two, password-reset emails are
# skipped and the request is logged instead of failing.
EMAIL =
PASSWORD =
# Optional — defaults shown. Port 465 is implicit TLS; use 587 for STARTTLS.
EMAIL_HOST = smtp.gmail.com
EMAIL_PORT = 465
# What recipients see in the From line. Defaults to EMAIL.
EMAIL_FROM =

# password reset
# How long an emailed reset link stays redeemable, in minutes.
PASSWORD_RESET_TTL_MINUTES = 30
# Minimum gap between two reset emails for the same account, in seconds.
PASSWORD_RESET_COOLDOWN_SECONDS = 60

# security
# Number of reverse-proxy hops in front of this app (Express `trust proxy`).
# 0 = no proxy: local dev, or a directly exposed container. Behind one load
# balancer set 1. Too low and every request looks like it came from the proxy,
# so one noisy client rate-limits everyone; too high and a client can spoof
# X-Forwarded-For to dodge the limit.
TRUST_PROXY = 0
# Maximum accepted request body size.
BODY_LIMIT = 1mb
# Per-IP request budgets, each over a 15-minute window.
RATE_LIMIT_API_MAX = 1000
# Failed logins only — successful ones are not counted.
RATE_LIMIT_LOGIN_MAX = 10
# Register / forgot-password / reset-password; counts every request.
RATE_LIMIT_SENSITIVE_MAX = 10

# background sweeps (src/scheduler)
# Retries failed refunds, settles refunds stuck PROCESSING, and expires stale
# checkout drafts. The scheduler runs IN-PROCESS, so every instance with this
# enabled runs every sweep — with more than one instance deployed, leave it on
# for exactly one of them. Set to "false" to disable.
SCHEDULER_ENABLED = true